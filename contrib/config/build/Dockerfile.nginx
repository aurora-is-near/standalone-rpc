# endpoint.conf uses nchan websocket directives, so the official
# nginx image needs that module built for the same nginx version.
FROM nginx:1.30.7-alpine AS builder

ARG NCHAN_VERSION=1.3.9

RUN apk add --no-cache --virtual .build-deps \
        gcc \
        libc-dev \
        make \
        openssl-dev \
        pcre2-dev \
        zlib-dev \
        linux-headers \
        curl \
    && curl -fsSL "https://nginx.org/download/nginx-${NGINX_VERSION}.tar.gz" -o /tmp/nginx.tar.gz \
    && curl -fsSL "https://github.com/slact/nchan/archive/refs/tags/v${NCHAN_VERSION}.tar.gz" -o /tmp/nchan.tar.gz \
    && mkdir -p /usr/src /out \
    && tar -xzf /tmp/nginx.tar.gz -C /usr/src \
    && tar -xzf /tmp/nchan.tar.gz -C /usr/src \
    && cd "/usr/src/nginx-${NGINX_VERSION}" \
    && ./configure --with-compat --with-http_ssl_module \
        --add-dynamic-module="/usr/src/nchan-${NCHAN_VERSION}" \
    && make modules \
    && cp objs/ngx_nchan_module.so /out/ngx_nchan_module.so

FROM nginx:1.30.7-alpine

COPY --from=builder /out/ngx_nchan_module.so /usr/lib/nginx/modules/ngx_nchan_module.so
COPY contrib/config/build/nginx/nginx.conf /etc/nginx/nginx.conf
COPY --chmod=755 contrib/config/build/nginx/exec.sh /usr/local/bin/exec.sh

RUN nginx -t \
    && rm -f /etc/nginx/conf.d/default.conf

VOLUME /config
EXPOSE 80
ENTRYPOINT ["/usr/local/bin/exec.sh"]
CMD ["nginx", "-g", "daemon off;"]
